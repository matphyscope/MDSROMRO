unfix prod

# ===========================================================================
# SECTION 2 — COOLING: 1800K → 300K  (direct, no intermediate hold)
# Mirrors experiment: cool directly from T_max to 300K
# Ramp rate: 1500K / 75ps = 20 K/ps
# ===========================================================================

fix  cool all npt temp 1800 300 0.1 iso 0.0 0.0 1.0
run  150000             # 75 ps  (1800 → 300K at 20 K/ps)
unfix cool

# ── Equilibrate at 300K ──────────────────────────────────────────────────
fix  eq_cool all npt temp 300 300 0.1 iso 0.0 0.0 1.0
run  400000             # 200 ps equilibration
unfix eq_cool

# ── Collect after-cooling 300K structure ─────────────────────────────────
fix  prod_cool all npt temp 300 300 0.1 iso 0.0 0.0 1.0
# ── Data collection: cool_T0300 ─────────────────────────────────────────
dump   dmp_cool_T0300 all atom 1000 dump_cool_T0300.lammpstrj
dump_modify dmp_cool_T0300 sort id
fix  fRDF all ave/time 100 10 1000 c_allRDF[*] &
     file rdf_cool_T0300.txt mode vector
fix  fCN  all ave/time 100 10 1000 &
     v_CN_Si v_CN_Si_SRO v_CN_C v_CN_N &
     v_pSi_Si v_pSi_C v_pSi_N v_pC_C v_pC_Si v_pN_Si &
     file CN_cool_T0300.txt
fix  fADF all ave/time 100 10 1000 &
     c_aNSiN[*] c_aCSiC[*] c_aCSiN[*] &
     c_aSiCSi[*] c_aSiNSi[*] c_aCCC[*] &
     file angles_cool_T0300.txt mode vector
fix  fThm all ave/time 100 10 1000 &
     v_vtemp v_vpress v_vdensity v_vpe &
     file thermo_cool_T0300.txt
run  400000             # 200 ps production
undump dmp_cool_T0300
unfix fRDF
unfix fCN
unfix fADF
unfix fThm
print ">>> DONE: cool_T0300  T_MD=300K  T_exp~300K"
print "    Files: rdf_cool_T0300.txt  CN_cool_T0300.txt  angles_cool_T0300.txt  thermo_cool_T0300.txt  dump_cool_T0300.lammpstrj"

unfix prod_cool

# ===========================================================================
# FINAL
# ===========================================================================
min_style cg
minimize  1.0e-6 1.0e-8 10000 100000
write_data SiCN_Tscan_final.data

print "============================================================"
print "T-SCAN COMPLETE"
print "Heating : T0300 ~ T1800  (16 points)"
print "Cooling : cool_T0300     (1 point)"
print "Per point: rdf / CN / angles / thermo / dump"
print "Final structure: SiCN_Tscan_final.data"
print "============================================================"