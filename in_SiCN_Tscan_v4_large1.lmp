# in_SiCN_Tscan_v4_large.lmp (v3 + RDF cutoff 10)
# ---------------------------------------------------------------------------
# a-SiCN T-scan: 300K → 1800K (100K steps) → 1800K → 300K (direct cool)
# ONE continuous in-situ run
# ---------------------------------------------------------------------------
#
# OUTPUT PER TEMPERATURE POINT:
#   rdf_T????.txt        partial g(r): Si-Si, Si-C, Si-N, C-C, C-N, N-N
#   CN_T????.txt         coordination numbers (10 quantities)
#   angles_T????.txt     ADF: N-Si-N, C-Si-C, C-Si-N, Si-C-Si, Si-N-Si, C-C-C
#   thermo_T????.txt     density, PE, T, P  (time-averaged)
#   dump_T????.lammpstrj atom trajectory during production (200 ps)
#
# DATA COLLECTION METHOD:
#   fix ave/time 100 10 1000 → time-averaged over 200 ps production
#   dump every 1000 steps    → 200 frames per temperature point
#
# MD ↔ EXPERIMENT SCALE (α = 1.50):
#   T_exp = 300 + (T_MD - 300) / 1.50
#   MD 1800K = Exp ~1300K  (covers experiment max 1200K + margin)
#
# HEATING : 300, 400, ..., 1800 K  (16 points)
# COOLING : 1800K → 300K direct → equilibrate → collect
#
# USAGE:
#   nohup mpirun -np 32 lmp -in in_SiCN_Tscan_unified_v3.lmp > log.tscan 2>&1 &
# ---------------------------------------------------------------------------

units           metal
atom_style      atomic
boundary        p p p

read_data       SiCN_300K_final.data

mass 1 28.09    # Si
mass 2 12.01    # C
mass 3 14.01    # N

group gSi type 1
group gC  type 2
group gN  type 3

variable NS equal count(gSi)
variable NC equal count(gC)
variable NN equal count(gN)

pair_style      tersoff
pair_coeff      * * SiCN.tersoff Si C N

comm_modify     cutoff 12.0
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes
timestep        0.0005          # 0.5 fs

thermo_style    custom step temp press vol pe ke etotal density
thermo          2000

velocity        all create 300 54321 dist gaussian mom yes rot yes

# ===========================================================================
# COMPUTES — defined once, active throughout entire run
# ===========================================================================

# Partial RDF: Si-Si, Si-C, Si-N, C-C, C-N, N-N
compute allRDF all rdf 1000 1 1  1 2  1 3  2 2  2 3  3 3  cutoff 10.0

# CN — Si-centred
compute cSi_C  gSi coord/atom cutoff 2.25 2
compute cSi_N  gSi coord/atom cutoff 2.15 3
compute cSi_Si gSi coord/atom cutoff 2.70 1
compute sSi_C  gSi reduce sum c_cSi_C
compute sSi_N  gSi reduce sum c_cSi_N
compute sSi_Si gSi reduce sum c_cSi_Si
variable pSi_Si    equal c_sSi_Si/v_NS
variable pSi_C     equal c_sSi_C/v_NS
variable pSi_N     equal c_sSi_N/v_NS
variable CN_Si     equal (c_sSi_Si+c_sSi_C+c_sSi_N)/v_NS
variable CN_Si_SRO equal (c_sSi_C+c_sSi_N)/v_NS

# CN — C-centred
compute cC_C  gC coord/atom cutoff 1.85 2
compute cC_Si gC coord/atom cutoff 2.25 1
compute sC_C  gC reduce sum c_cC_C
compute sC_Si gC reduce sum c_cC_Si
variable pC_C  equal c_sC_C/v_NC
variable pC_Si equal c_sC_Si/v_NC
variable CN_C  equal (c_sC_C+c_sC_Si)/v_NC

# CN — N-centred
compute cN_Si gN coord/atom cutoff 2.15 1
compute sN_Si gN reduce sum c_cN_Si
variable pN_Si equal c_sN_Si/v_NN
variable CN_N  equal c_sN_Si/v_NN

# Thermo variables
variable vdensity equal density
variable vpe      equal pe
variable vtemp    equal temp
variable vpress   equal press

# ADF — 6 triplets
compute aNSiN  all adf 180 1 3 3 0.0 2.15 0.0 2.15   # N-Si-N
compute aCSiC  all adf 180 1 2 2 0.0 2.25 0.0 2.25   # C-Si-C
compute aCSiN  all adf 180 1 2 3 0.0 2.25 0.0 2.15   # C-Si-N
compute aSiCSi all adf 180 2 1 1 0.0 2.25 0.0 2.25   # Si-C-Si
compute aSiNSi all adf 180 3 1 1 0.0 2.15 0.0 2.15   # Si-N-Si
compute aCCC   all adf 180 2 2 2 0.0 1.85 0.0 1.85   # C-C-C

# ===========================================================================
# SECTION 1 — HEATING: 300K → 1800K  (16 points, 100K interval)
# ===========================================================================

# ════════════════════════════════════════════════════════════════════
# T0300  |  T_MD = 300 K  |  T_exp ≈ 300 K
# ════════════════════════════════════════════════════════════════════
fix  eq   all npt temp 300 300 0.1 iso 0.0 0.0 1.0
run  400000             # 200 ps equilibration
unfix eq

fix  prod all npt temp 300 300 0.1 iso 0.0 0.0 1.0
# ── Data collection: T0300 ─────────────────────────────────────────
dump   dmp_T0300 all atom 1000 dump_T0300.lammpstrj
dump_modify dmp_T0300 sort id
fix  fRDF all ave/time 100 10 1000 c_allRDF[*] &
     file rdf_T0300.txt mode vector
fix  fCN  all ave/time 100 10 1000 &
     v_CN_Si v_CN_Si_SRO v_CN_C v_CN_N &
     v_pSi_Si v_pSi_C v_pSi_N v_pC_C v_pC_Si v_pN_Si &
     file CN_T0300.txt
fix  fADF all ave/time 100 10 1000 &
     c_aNSiN[*] c_aCSiC[*] c_aCSiN[*] &
     c_aSiCSi[*] c_aSiNSi[*] c_aCCC[*] &
     file angles_T0300.txt mode vector
fix  fThm all ave/time 100 10 1000 &
     v_vtemp v_vpress v_vdensity v_vpe &
     file thermo_T0300.txt
run  400000             # 200 ps production
undump dmp_T0300
unfix fRDF
unfix fCN
unfix fADF
unfix fThm
print ">>> DONE: T0300  T_MD=300K  T_exp~300K"
print "    Files: rdf_T0300.txt  CN_T0300.txt  angles_T0300.txt  thermo_T0300.txt  dump_T0300.lammpstrj"

unfix prod

# ════════════════════════════════════════════════════════════════════
# T0400  |  T_MD = 400 K  |  T_exp ≈ 366 K
# ════════════════════════════════════════════════════════════════════
fix  ramp all npt temp 300 400 0.1 iso 0.0 0.0 1.0
run  40000              # 20 ps ramp
unfix ramp

fix  eq   all npt temp 400 400 0.1 iso 0.0 0.0 1.0
run  400000             # 200 ps equilibration
unfix eq

fix  prod all npt temp 400 400 0.1 iso 0.0 0.0 1.0
# ── Data collection: T0400 ─────────────────────────────────────────
dump   dmp_T0400 all atom 1000 dump_T0400.lammpstrj
dump_modify dmp_T0400 sort id
fix  fRDF all ave/time 100 10 1000 c_allRDF[*] &
     file rdf_T0400.txt mode vector
fix  fCN  all ave/time 100 10 1000 &
     v_CN_Si v_CN_Si_SRO v_CN_C v_CN_N &
     v_pSi_Si v_pSi_C v_pSi_N v_pC_C v_pC_Si v_pN_Si &
     file CN_T0400.txt
fix  fADF all ave/time 100 10 1000 &
     c_aNSiN[*] c_aCSiC[*] c_aCSiN[*] &
     c_aSiCSi[*] c_aSiNSi[*] c_aCCC[*] &
     file angles_T0400.txt mode vector
fix  fThm all ave/time 100 10 1000 &
     v_vtemp v_vpress v_vdensity v_vpe &
     file thermo_T0400.txt
run  400000             # 200 ps production
undump dmp_T0400
unfix fRDF
unfix fCN
unfix fADF
unfix fThm
print ">>> DONE: T0400  T_MD=400K  T_exp~366K"
print "    Files: rdf_T0400.txt  CN_T0400.txt  angles_T0400.txt  thermo_T0400.txt  dump_T0400.lammpstrj"

unfix prod

