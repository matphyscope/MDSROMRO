# ════════════════════════════════════════════════════════════════════
fix  ramp all npt temp 2900 3000 0.1 iso 0.0 0.0 1.0
run  40000              # 20 ps ramp
unfix ramp

fix  eq   all npt temp 3000 3000 0.1 iso 0.0 0.0 1.0
run  400000             # 200 ps equilibration
unfix eq

