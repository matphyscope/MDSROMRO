     file rdf_T0400.txt mode vector
fix  fCN  all ave/time 100 10 1000 &
     v_CN_Si v_CN_Si_SRO v_CN_C v_CN_N &
     v_pSi_Si v_pSi_C v_pSi_N v_pC_C v_pC_Si v_pN_Si &
     file CN_T0400.txt
fix  fADF all ave/time 100 10 1000 &
     c_aNSiN[*] c_aCSiC[*] c_aCSiN[*] &
     c_aSiCSi[*] c_aSiNSi[*] c_aCCC[*] &
     file angles_T0400.txt mode vector
fix  fThm all ave/time 100 10 1000 &
     v_vtemp v_vpress v_vdensity v_vpe &
     file thermo_T0400.txt
run  400000             # 200 ps production
undump traj
unfix fRDF
unfix fCN
unfix fADF
unfix fThm
print ">>> DONE: T0400  T_MD=400K  T_exp~366K"
print "    Files: rdf_T0400.txt  CN_T0400.txt  angles_T0400.txt  thermo_T0400.txt  dump.400K.lammpstrj"

unfix prod

