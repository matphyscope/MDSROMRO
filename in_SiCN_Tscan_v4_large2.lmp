# T2700  |  T_MD = 2700 K  |  T_exp ≈ 1900 K
# ════════════════════════════════════════════════════════════════════
fix  ramp all npt temp 2600 2700 0.1 iso 0.0 0.0 1.0
run  40000              # 20 ps ramp
unfix ramp

fix  eq   all npt temp 2700 2700 0.1 iso 0.0 0.0 1.0
run  400000             # 200 ps equilibration
unfix eq

fix  prod all npt temp 2700 2700 0.1 iso 0.0 0.0 1.0
# ── Data collection: T2700 ──────────────────────
dump        traj all custom 1000 dump.2700K.lammpstrj id type element x y z
dump_modify traj element Si C N sort id
fix  fRDF all ave/time 100 10 1000 c_allRDF[*] &
     file rdf_T2700.txt mode vector
fix  fCN  all ave/time 100 10 1000 &
     v_CN_Si v_CN_Si_SRO v_CN_C v_CN_N &
     v_pSi_Si v_pSi_C v_pSi_N v_pC_C v_pC_Si v_pN_Si &
     file CN_T2700.txt
fix  fADF all ave/time 100 10 1000 &
     c_aNSiN[*] c_aCSiC[*] c_aCSiN[*] &
     c_aSiCSi[*] c_aSiNSi[*] c_aCCC[*] &
     file angles_T2700.txt mode vector
fix  fThm all ave/time 100 10 1000 &
     v_vtemp v_vpress v_vdensity v_vpe &
     file thermo_T2700.txt
run  400000             # 200 ps production
undump traj
unfix fRDF
unfix fCN
unfix fADF
unfix fThm
print ">>> DONE: T2700  T_MD=2700K  T_exp~1900K"
print "    Files: rdf_T2700.txt  CN_T2700.txt  angles_T2700.txt  thermo_T2700.txt  dump.2700K.lammpstrj"

unfix prod

