# in_SiCN_v8_large.lmp (8400 atoms, L=45, Si37/C35.8/N27.0, RDF cutoff 10)
# ---------------------------------------------------------------------------
# Amorphous SiCN melt-quench-anneal (Unified SiCN.tersoff)
# v7 — single unified Tersoff potential file (no more hybrid/overlay)
# ---------------------------------------------------------------------------
# CHANGES FROM v6:
#   - pair_style: hybrid/overlay tersoff tersoff  ->  tersoff
#   - pair_coeff: 2 lines + `2 3 none`  ->  1 line (SiCN.tersoff Si C N)
#   - C-N now repulsion-only (chi_CN = 0, A_CN = 2979.03) via the file itself
#     — close-contact artifact at r < 1 Å eliminated by short-range repulsion
#   - N-N still B = 0 (Mota); Si-Si no doubling (single potential)
#   - Following Liao 2012 / Matsunaga 1999 / Wang 2022 unified-file convention
#   - Everything else (composition, cutoffs, NPT, ADF/CN computes) UNCHANGED
#
# COMPOSITION    : Si=3114, C=3013, N=2273  (8400 atoms, Si37_C35.8_N27.0)
# INITIAL DENSITY: 2.8336 g/cc at L=45 (NPT will relax to its equilibrium value)
# POTENTIALS     : SiCN.tersoff (unified Tersoff: Si-Si/C-C/Si-C from Tersoff 89,
#                                Si-N from Mota 98, N-N B=0, C-N chi_CN=0)
# ENSEMBLE       : NPT (iso, 0 bar) for ALL dynamics segments
# QUENCH RATE    : 20 K/ps for all cool segments (slow quench)
# TOTAL TIME     : ~1.19 ns simulated
# RUN            : lmp -in in_SiCN_v7_unified.lmp -var SEED 12345
# ---------------------------------------------------------------------------

units           metal
atom_style      atomic
boundary        p p p

# ---------- Composition & box ----------
variable        L     equal 45.000      # Å (v7: 23.500)
variable        NS    equal 3114        # Si  (Si37_C35.8_N27.0)
variable        NC    equal 3013        # C
variable        NN    equal 2273        # N   (total 8400)
# SEED supplied at command line: -var SEED <int>

region          box block 0 ${L} 0 ${L} 0 ${L} units box
create_box      3 box
create_atoms    1 random ${NS} ${SEED} box overlap 1.3 maxtry 500
create_atoms    2 random ${NC} ${SEED} box overlap 1.3 maxtry 500
create_atoms    3 random ${NN} ${SEED} box overlap 1.3 maxtry 500

mass 1 28.09
mass 2 12.01
mass 3 14.01

group gSi type 1
group gC  type 2
group gN  type 3

# ---------- Potentials ----------
pair_style      tersoff
pair_coeff      * * SiCN.tersoff Si C N
# (C-N pair now handled within SiCN.tersoff via chi_CN=0; no `pair_coeff 2 3 none` needed)

comm_modify     cutoff 12.0
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes
timestep        0.0005     # 0.5 fs

thermo_style    custom step temp press vol pe ke etotal density
thermo          5000

# ---------- Analysis computes ----------
# RDF: 6 partials (Si-Si, Si-C, Si-N, C-C, C-N, N-N)
compute allRDF all rdf 1000 1 1 1 2 1 3 2 2 2 3 3 3 cutoff 10.0

# === CN — REFINED CUTOFFS (v6) ===
# Si centered
compute cSi_C  gSi coord/atom cutoff 2.25 2     # Si-C   (v5: 2.34 -> v6: 2.25)
compute cSi_N  gSi coord/atom cutoff 2.15 3     # Si-N   (v5: 2.23 -> v6: 2.15)
compute cSi_Si gSi coord/atom cutoff 2.70 1     # Si-Si  (v5: 2.94 -> v6: 2.70)
compute sSi_C  gSi reduce sum c_cSi_C
compute sSi_N  gSi reduce sum c_cSi_N
compute sSi_Si gSi reduce sum c_cSi_Si
variable pSi_Si    equal c_sSi_Si/${NS}
variable pSi_C     equal c_sSi_C/${NS}
variable pSi_N     equal c_sSi_N/${NS}
variable CN_Si     equal (c_sSi_Si+c_sSi_C+c_sSi_N)/${NS}
variable CN_Si_SRO equal (c_sSi_C+c_sSi_N)/${NS}

# C centered
compute cC_C  gC coord/atom cutoff 1.85 2       # C-C   (v5: 1.75 -> v6: 1.85)
compute cC_Si gC coord/atom cutoff 2.25 1       # C-Si  (v5: 2.34 -> v6: 2.25)
compute sC_C  gC reduce sum c_cC_C
compute sC_Si gC reduce sum c_cC_Si
variable pC_C    equal c_sC_C/${NC}
variable pC_Si   equal c_sC_Si/${NC}
variable CN_C    equal (c_sC_C+c_sC_Si)/${NC}

# N centered
compute cN_Si gN coord/atom cutoff 2.15 1       # N-Si  (v5: 2.23 -> v6: 2.15)
compute sN_Si gN reduce sum c_cN_Si
variable pN_Si equal c_sN_Si/${NN}
variable CN_N  equal c_sN_Si/${NN}

# === ADF — Refined cutoffs (aligned with CN) ===
compute aNSiN  all adf 180 1 3 3 0.0 2.15 0.0 2.15
compute aCSiC  all adf 180 1 2 2 0.0 2.25 0.0 2.25
compute aCSiN  all adf 180 1 2 3 0.0 2.25 0.0 2.15
compute aSiCSi all adf 180 2 1 1 0.0 2.25 0.0 2.25
compute aSiNSi all adf 180 3 1 1 0.0 2.15 0.0 2.15
compute aCCC   all adf 180 2 2 2 0.0 1.85 0.0 1.85

# ===========================================================================
# (1) Initial CG minimization — remove random-placement overlaps
# ===========================================================================
min_style       cg
min_modify      dmax 0.05 line quadratic
minimize        1.0e-4 1.0e-6 5000 50000

reset_timestep  0
velocity        all create 300.0 ${SEED} dist gaussian

# ===========================================================================
# (2) Heat 300 K -> 5500 K  (26 ps, NPT, ~200 K/ps)
# ===========================================================================
fix heat all npt temp 300.0 5500.0 0.1 iso 0.0 0.0 1.0
run 52000
unfix heat

# ===========================================================================
# (3) Melt hold @ 5500 K  (50 ps, NPT) + MSD monitor (liquid-state check)
# ===========================================================================
compute msdSi gSi msd
fix melt all npt temp 5500.0 5500.0 0.1 iso 0.0 0.0 1.0
fix fmsd all ave/time 100 1 100 c_msdSi[4] file msd_5500K.txt
run 100000
unfix melt
unfix fmsd
uncompute msdSi

# ===========================================================================
# (4) Slow cool 5500 K -> 2500 K  (150 ps, NPT, -20 K/ps)
# ===========================================================================
fix q1 all npt temp 5500.0 2500.0 0.1 iso 0.0 0.0 1.0
run 300000
unfix q1

# ===========================================================================
# (5) Anneal @ 2500 K  (100 ps, NPT)
# ===========================================================================
fix mid all npt temp 2500.0 2500.0 0.1 iso 0.0 0.0 1.0
run 200000
unfix mid

# ===========================================================================
# (6) Slow cool 2500 K -> 1273 K  (60 ps, NPT, ~20 K/ps)
# ===========================================================================
fix q2 all npt temp 2500.0 1273.0 0.1 iso 0.0 0.0 1.0
run 120000
unfix q2

# ===========================================================================
# (7) NPT plateau @ 1273 K  (400 ps) — density relaxation + measurement
# ===========================================================================
fix eq1273 all npt temp 1273.0 1273.0 0.1 iso 0.0 0.0 1.0
fix fRDF_1273 all ave/time 100 10 1000 c_allRDF[*] file rdf_1273K.txt mode vector
fix fCN_1273  all ave/time 100 10 1000 v_CN_Si v_CN_Si_SRO v_CN_C v_CN_N v_pSi_Si v_pSi_C v_pSi_N v_pC_C v_pC_Si v_pN_Si file CN_1273K.txt
fix fADF_1273 all ave/time 100 10 1000 c_aNSiN[*] c_aCSiC[*] c_aCSiN[*] c_aSiCSi[*] c_aSiNSi[*] c_aCCC[*] file angles_1273K.txt mode vector
dump        traj all custom 1000 dump.1273K.lammpstrj id type element x y z
dump_modify traj element Si C N sort id
run 800000
undump traj
unfix eq1273
unfix fRDF_1273
unfix fCN_1273
unfix fADF_1273

# ===========================================================================
# (8) Slow cool 1273 K -> 300 K  (50 ps, NPT, ~20 K/ps)
# ===========================================================================
fix cool300 all npt temp 1273.0 300.0 0.1 iso 0.0 0.0 1.0
run 100000
unfix cool300

# ===========================================================================
# (9) NPT plateau @ 300 K  (350 ps) — final measurement
# ===========================================================================
fix eq300 all npt temp 300.0 300.0 0.1 iso 0.0 0.0 1.0
fix fRDF_300 all ave/time 100 10 1000 c_allRDF[*] file rdf_300K.txt mode vector
fix fCN_300  all ave/time 100 10 1000 v_CN_Si v_CN_Si_SRO v_CN_C v_CN_N v_pSi_Si v_pSi_C v_pSi_N v_pC_C v_pC_Si v_pN_Si file CN_300K.txt
fix fADF_300 all ave/time 100 10 1000 c_aNSiN[*] c_aCSiC[*] c_aCSiN[*] c_aSiCSi[*] c_aSiNSi[*] c_aCCC[*] file angles_300K.txt mode vector
dump        traj all custom 1000 dump.300K.lammpstrj id type element x y z
dump_modify traj element Si C N sort id
run 700000
undump traj
unfix eq300
unfix fRDF_300
unfix fCN_300
unfix fADF_300

# ===========================================================================
# (10) Final CG minimization
# ===========================================================================
min_style cg
minimize 1.0e-6 1.0e-8 10000 100000
write_data SiCN_300K_final.data

print "============================================================"
print "DONE  Unified SiCN.tersoff (v7, all-NPT, chi_CN=0)"
print "SEED = ${SEED}"
print "Initial L = ${L} Å (NPT-relaxed; check thermo for final density)"
print "Total simulated time ~1.19 ns"
print "============================================================"
